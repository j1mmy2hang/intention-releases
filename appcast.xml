        <item>
            <title>0.2.2</title>
            <pubDate>Thu, 30 Jul 2026 12:44:48 +0700</pubDate>
            <sparkle:version>6</sparkle:version>
            <sparkle:shortVersionString>0.2.2</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[- The introduction now actually appears on a first run. It was being counted as shown the moment it
  reached the screen rather than once you had read it, so anything that took it away first — the
  ⌃⌥⌘B bypass, the screen resting, quitting the app — meant it never came back. And starting an
  intention from the menu bar skipped it altogether, which on a fresh install is the likeliest thing
  to click, since there is no window. It is now counted only when you reach the end of it.
]]></description>
            <enclosure url="https://raw.githubusercontent.com/j1mmy2hang/intention-releases/main/Intention-0.2.2.zip" length="3340035" type="application/octet-stream" sparkle:edSignature="6Jstr9ylHRx/JL7mmVdrYU6nqyzO8wTm1JzaMxon5E6jrrgJ5WcROhhXJy5AN7NNjVpKUlqTyor0UJpi1Tx9BQ=="/>
